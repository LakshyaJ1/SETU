    {"id":"roads","type":"line","source":"city","minzoom":12,"filter":["==","kind","road"],"layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#FCFDF8","line-width":["interpolate",["linear"],["zoom"],12,1,16,6,18,20]}},

    {"id":"park-labels","type":"symbol","source":"city","minzoom":13,"filter":["all",["==","kind","park"],["!=","name",""]],"layout":{"text-field":"{name}","text-font":["Noto Sans Regular"],"text-size":14,"text-max-width":8,"text-padding":16},"paint":{"text-color":"#657D45","text-halo-color":"#DFE9C7","text-halo-width":1.5}}
